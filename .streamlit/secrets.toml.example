# Copy into the Streamlit Community Cloud "Secrets" box (App settings → Secrets).
# NEVER commit a real secrets.toml — it is in .gitignore.
APP_MODE = "cloud"

# --- persistence (recommended: indexes survive restarts) ---
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxx"        # fine-grained token, write access to ONE dataset
HF_DATASET_REPO = "your-hf-username/datasheet-rag-data"   # PRIVATE dataset repo

# --- protect uploads / delete / re-index ---
ADMIN_PASSWORD = "change-me-long-random"
PUBLIC_UPLOADS = "false"

# --- optional: an open-model LLM server you control (Oracle VM etc.) ---
# Leave LLM_BASE_URL empty → zero-LLM extractive answers (still cited).
# LLM_BASE_URL = "https://llm.your-domain.example/v1"
# LLM_API_KEY = "long-random-key-set-on-your-server"
# LLM_MODEL = "qwen2.5:3b"

# --- optional: extra answer models in the sidebar menu (LLM2_* … LLM5_*) ---
# LLM_LABEL = "Qwen 2.5 3B (my VM)"
# LLM2_LABEL = "Kimi K2.6 (OpenRouter free)"
# LLM2_BASE_URL = "https://openrouter.ai/api/v1"
# LLM2_MODEL = "moonshotai/kimi-k2.6:free"
# LLM2_API_KEY = "sk-or-..."
# LLM3_LABEL = "Kimi K2.6 (via my VM's Ollama Cloud login)"
# LLM3_MODEL = "kimi-k2.6:cloud"          # empty LLM3_BASE_URL = same server/key as LLM_BASE_URL
