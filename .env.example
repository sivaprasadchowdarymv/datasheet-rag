# Copy to .env for LOCAL development (never commit .env).
# Every key is optional; profile defaults live in config.py.

# local = Ollama on this PC (mistral / nomic-embed-text / llava:7b)
# cloud = no Ollama needed (fastembed ONNX + optional remote LLM)
APP_MODE=local

# --- Ollama (local mode, or a remote Ollama you own) ---
OLLAMA_HOST=http://localhost:11434
# OLLAMA_AUTH_HEADER=Bearer your-token          # if your remote Ollama sits behind a proxy
# LLM_MODEL=mistral
# EMBEDDING_MODEL=nomic-embed-text
# VISION_MODEL=llava:7b

# --- OpenAI-compatible open-model server (cloud mode) ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1        # Ollama, llama.cpp server, vLLM...
# LLM_API_KEY=

# --- extra answer models shown in the sidebar menu "Answer model" (optional) ---
# Up to four extras: LLM2_* … LLM5_*. Any OpenAI-compatible server works.
# Kimi K2.6, free tier on OpenRouter (rate limited; prompts go to a third party):
# LLM2_LABEL=Kimi K2.6 (OpenRouter free)
# LLM2_BASE_URL=https://openrouter.ai/api/v1
# LLM2_MODEL=moonshotai/kimi-k2.6:free
# LLM2_API_KEY=sk-or-...
# Kimi through your own Ollama signed in to ollama.com (empty URL = same server as the main LLM):
# LLM3_LABEL=Kimi K2.6 (Ollama Cloud)
# LLM3_MODEL=kimi-k2.6:cloud
# LLM_LABEL=Qwen 2.5 3B (my VM)                 # name of the main LLM in that menu

# --- retrieval ---
TOP_K_RETRIEVAL=20
TOP_K_FINAL=6
ENABLE_RERANKER=true
RERANK_MIN_SCORE=0.02

# --- chunking (changing these triggers automatic re-index) ---
MAX_CHUNK_TOKENS=400
OVERLAP_TOKENS=60

# --- storage ---
DATA_DIR=./data
CACHE_DIR=./cache
# STORAGE_BACKEND=hf
# HF_TOKEN=
# HF_DATASET_REPO=

# --- security ---
MAX_UPLOAD_MB=50
MAX_PAGES=400
QUERIES_PER_MINUTE=10
ADMIN_PASSWORD=
PUBLIC_UPLOADS=true
